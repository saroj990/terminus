# LLM provider: "heuristic" (default, no network) | "ollama" | "openai"
LCA_PROVIDER=heuristic

# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# OpenAI-compatible API (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Weather tool (Open-Meteo needs no key; optional override for demos)
WEATHER_LAT=51.5074
WEATHER_LON=-0.1278
