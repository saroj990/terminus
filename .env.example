# LLM provider: "heuristic" (default, no network) | "ollama" | "openai"
LCA_PROVIDER=heuristic

# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# OpenAI-compatible API (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Weather tool (Open-Meteo needs no key; optional override for demos)
WEATHER_LAT=51.5074
WEATHER_LON=-0.1278

# GitHub tools (Phase 6) — dry-run unless LCA_GITHUB_LIVE=1 (policy asks before live writes)
#LCA_GITHUB_LIVE=0

# Deploy tools (Phase 8) — dry-run unless LCA_DEPLOY_LIVE=1 (policy asks before live deploy/build)
#LCA_DEPLOY_LIVE=0
#LCA_STAGING_URL=https://staging.example.com
